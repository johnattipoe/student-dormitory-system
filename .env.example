# Environment variables for the Student Dormitory System application
APP_NAME="Student Dormitory System"
APP_ENV=development

# Application URL
APP_URL=http://localhost:8000
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# Firebase Configuration
FIREBASE_ENABLED=true
FIREBASE_READ_DIAGNOSTICS=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS=credentials/firebase-service-account.json
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-firebase-project-default-rtdb.firebaseio.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Redis cache (run with: docker compose up -d redis)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_CACHE_PREFIX=student-dormitory

# Cloudflare R2 gallery storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=student-dormitory-gallery
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=

# Session
SESSION_NAME=dormitory_session

# FastAPI Configuration
FASTAPI_REQUIRE_AUTH=false
FASTAPI_BASE_URL=http://localhost:8001
FASTAPI_API_TOKEN=change-me
FASTAPI_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# SMTP email delivery (leave disabled until all provider values are configured)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=your-mail-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME="Student Dormitory System"
