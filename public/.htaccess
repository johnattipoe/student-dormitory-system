RewriteEngine On

# Block direct access to sensitive folders if they ever end up under public/
RewriteRule ^(credentials|storage|vendor)/ - [F,L]

# Pretty-route everything that isn't a real file/dir through index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=/views/$1 [QSA,L]
